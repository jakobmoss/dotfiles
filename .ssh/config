#
# Global settings
#
Host *
  IgnoreUnknown AddKeysToAgent,UseKeychain
  AddKeysToAgent yes
  UseKeychain yes
  IdentityFile ~/.ssh/id_ed25519
  ForwardAgent yes
  XAuthLocation /opt/X11/bin/xauth
  ControlMaster auto


# ~~~~~~~~~~

#
# Home machine | Requires machine on 'staff' VLAN @ home
#

Host home
User moss
HostName 192.168.20.20
ControlPath ~/.ssh/home.sock
ForwardX11 yes
ForwardX11Trusted yes


